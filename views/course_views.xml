<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!--course list view-->
        <record id="course_list_view" model="ir.ui.view">
            <field name="name">college.course.list</field>
            <field name="model">college.course</field>
            <field name="arch" type="xml">
                <list string="Courses">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="department"/>
                    <field name="duration"/>
                    <field name="fees"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!--course form view-->
        <record id="course_form_view" model="ir.ui.view">
            <field name="name">college.course.form</field>
            <field name="model">college.course</field>
            <field name="arch" type="xml">
                <form string="Course Details">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Enter Course Name"/>
                            </h1>
                        </div>

                        <group>
                            <group string="Course Information">
                                <field name="code"/>
                                <field name="department"/>
                                <field name="duration"/>
                            </group>

                            <group string="Fees Information">
                                <field name="fees"/>
                                <field name="active"/>
                            </group>
                        </group>

                        <group string="Description">
                            <field name="description" placeholder="Enter Course Description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!--course window-->
        <record id="course_action" model="ir.actions.act_window">
            <field name="name">Courses</field>
            <field name="res_model">college.course</field>
            <field name="view_mode">list,form</field>
        </record>

        <!--course menu-->
        <menuitem id="course_menu"
            name="Courses"
            parent="college_management_menu"
            action="course_action"
            sequence="1"/>
    </data>
</odoo>