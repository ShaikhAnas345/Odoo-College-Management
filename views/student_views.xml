<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--student list view-->
    <record id="student_list_view" model="ir.ui.view">
        <field name="name">college.student.list</field>
        <field name="model">college.student</field>
        <field name="arch" type="xml">
            <list string="Students">
                <field name="enrollment_no"/>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="course"/>
                <field name="admission_date"/>
            </list>
        </field>
    </record>

    <!--student form view-->
    <record id="student_form_view" model="ir.ui.view">
        <field name="name">college.student.form</field>
        <field name="model">college.student</field>
        <field name="arch" type="xml">
            <form string="Student Details">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Enter Student Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Personal Information">
                            <field name="enrollment_no"/>
                            <field name="gender"/>
                            <field name="dob"/>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>

                        <group string="Academic Information">
                            <field name="course"/>
                            <field name="admission_date"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <group string="Address">
                        <field name="address" placeholder="Enter full address"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--window action-->
    <record id="student_action" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">college.student</field>
        <field name="view_mode">list,form</field>
    </record>

    <!--menu items-->
    <menuitem id="college_management_menu" name="College Management" sequence="10"/>
    <menuitem id="student_menu" name="Students" parent="college_management_menu" action="student_action" sequence="1"/>
</odoo>